# Network configuration for the Pi image (optional).
# Copy this file to config/network.conf and edit.
#
# Leave everything blank for the default: DHCP on Ethernet via cloud-init.
# Values are sourced as shell variables — use no spaces around '='.

# --- Interface names (Ubuntu Pi defaults) ---
ETH_IF="eth0"
WIFI_IF="wlan0"

# --- Wi-Fi (leave WIFI_SSID blank to disable Wi-Fi entirely) ---
WIFI_SSID=""
WIFI_PASSWORD=""
WIFI_COUNTRY="US"          # 2-letter regulatory domain, needed to enable the radio

# --- Ethernet static IP (leave ETH_STATIC_IP blank for DHCP) ---
ETH_STATIC_IP=""           # e.g. 192.168.1.50/24   (CIDR suffix required)
ETH_GATEWAY=""             # e.g. 192.168.1.1
ETH_DNS=""                 # e.g. 8.8.8.8;1.1.1.1    (';'-separated)

# --- Wi-Fi static IP (leave WIFI_STATIC_IP blank for DHCP over Wi-Fi) ---
WIFI_STATIC_IP=""          # e.g. 192.168.1.51/24
WIFI_GATEWAY=""
WIFI_DNS=""
